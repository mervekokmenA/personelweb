# --- Veritabanı (Neon / Vercel Postgres) ---
# Neon panelinden alacağın standart (pooled) bağlantı dizesi.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Uygulamanın canlı adresi (Vercel deploy sonrası) ---
NEXT_PUBLIC_APP_URL="https://senin-projen.vercel.app"

# --- Vedik Astroloji: natal harita ---
# Bu değer ASLA repoya commit edilmez, arayüzde ham olarak gösterilmez.
# astro-seek.com (veya benzeri) sidereal/Lahiri, whole-sign bir haritadan
# okunan burç/derece/ev bilgisini JSON olarak tutar — kendi ephemeris
# hesaplamamıza değil doğrulanmış referans veriye dayanır (bkz. README).
# "retro" alanı opsiyoneldir. Ketu = Rahu'nun 180° karşıtı (aynı derece/dakika,
# 6 ev ileri).
# Opsiyonel ek noktalar (bodies içine eklenebilir, hepsi astro-seek.com'daki
# haritandan okunur — eklemezsen o nokta sayfada gösterilmez):
#   Chiron: Yaralı Şifacı  |  Lilith: Kara Ay (Black Moon Lilith, mean)
#   MC: Tepe noktası (Midheaven)  |  Vertex: Batı noktası
# Not: Alçalan (Descendant) otomatik hesaplanır (Yükselen + 180°), ayrıca
# eklemene gerek yok.
NATAL_CHART_JSON={"ascendant":{"sign":"Koç","deg":0,"min":0},"bodies":{"Sun":{"sign":"Koç","deg":0,"min":0,"house":1},"Moon":{"sign":"Koç","deg":0,"min":0,"house":1},"Mercury":{"sign":"Koç","deg":0,"min":0,"house":1},"Venus":{"sign":"Koç","deg":0,"min":0,"house":1},"Mars":{"sign":"Koç","deg":0,"min":0,"house":1},"Jupiter":{"sign":"Koç","deg":0,"min":0,"house":1},"Saturn":{"sign":"Koç","deg":0,"min":0,"house":1},"Uranus":{"sign":"Koç","deg":0,"min":0,"house":1},"Neptune":{"sign":"Koç","deg":0,"min":0,"house":1},"Pluto":{"sign":"Koç","deg":0,"min":0,"house":1},"Rahu":{"sign":"Koç","deg":0,"min":0,"house":1},"Ketu":{"sign":"Terazi","deg":0,"min":0,"house":7},"Chiron":{"sign":"Koç","deg":0,"min":0,"house":1},"Lilith":{"sign":"Koç","deg":0,"min":0,"house":1},"MC":{"sign":"Koç","deg":0,"min":0,"house":10},"Vertex":{"sign":"Koç","deg":0,"min":0,"house":1}}}

# --- Ayarlar sayfası: APK derleme (GitHub Actions tetikleme) ---
# GH_PAT: "repo" ve "workflow" izinli bir GitHub Personal Access Token
#   (Fine-grained token için: Actions: Read/Write, Contents: Read/Write)
# GH_REPO: "kullanici-adi/repo-adi" formatında
# GH_BRANCH: workflow'un tetikleneceği branch (varsayılan: main)
GH_PAT=""
GH_REPO=""
GH_BRANCH="main"

# --- Capacitor (yerel `npx cap sync` çalıştırırken opsiyonel) ---
CAPACITOR_SERVER_URL="https://senin-projen.vercel.app"
